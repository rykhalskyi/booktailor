# Environment fallback for BookTailor's Langfuse integration.
# App config set with `occ config:app:set` wins when present; otherwise the app
# reads these variables. Copy to deploy/nextcloud-langfuse.env and fill in the
# values from your Langfuse project.

BOOKTAILOR_LANGFUSE_URL=http://langfuse.homelab.home.arpa
BOOKTAILOR_LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE_ME
BOOKTAILOR_LANGFUSE_SECRET_KEY=sk-lf-CHANGE_ME
BOOKTAILOR_LANGFUSE_PROMPT_LABEL=production
