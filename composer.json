{
	"name": "nextcloud/booktailor",
	"description": "AI driven organizer of markdown files. Automate learning material creation flow",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "Iaroslav Rykhalskyi",
			"email": "otakeessent@gmail.com"
		}
	],
	"autoload": {
		"psr-4": {
			"OCA\\BookTailor\\": "lib/"
		}
	},
	"scripts": {
		"post-install-cmd": [
			"@composer bin all install --ansi"
		],
		"post-update-cmd": [
			"@composer bin all install --ansi"
		],
		"lint": "find . -name \\*.php -not -path './vendor/*' -not -path './vendor-bin/*' -not -path './build/*' -not -path './node_modules/*' -print0 | xargs -0 -n1 php -l",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --threads=1 --no-cache",
		"test:unit": "php -d memory_limit=1G vendor/bin/phpunit tests -c tests/phpunit.xml --colors=always --fail-on-warning --fail-on-risky",
		"openapi": "generate-spec",
		"rector": "rector && composer cs:fix"
	},
	"require": {
		"bamarni/composer-bin-plugin": "^1.8",
		"php": "^8.1"
	},
	"require-dev": {
		"doctrine/dbal": "^3.6",
		"nextcloud/ocp": "dev-stable31"
	},
	"config": {
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true
		},
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.1"
		}
	}
}
